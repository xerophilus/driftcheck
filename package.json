{
  "name": "driftcheck",
  "version": "1.0.0",
  "description": "Catch env/config drift between code, .env files, CI, and live hosting providers before deploy breaks",
  "type": "module",
  "bin": {
    "driftcheck": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && node scripts/postbuild.js",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "keygen": "node scripts/keygen.js",
    "prepublishOnly": "npm run build && npm run test"
  },
  "keywords": [
    "env",
    "dotenv",
    "vercel",
    "drift",
    "ci",
    "environment-variables",
    "config",
    "devops"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "yaml": "^2.3.4",
    "picocolors": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3",
    "vitest": "^1.0.4"
  },
  "engines": {
    "node": ">=18"
  }
}
